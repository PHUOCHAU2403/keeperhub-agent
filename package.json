{
  "name": "keeperhub-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent with its own balance sheet — earns via x402, executes through KeeperHub.",
  "scripts": {
    "test": "node --test ./test/rules.test.mjs ./test/memo.test.mjs ./test/economics.test.mjs",
    "once": "node --env-file=.env src/agent.js once",
    "loop": "node --env-file=.env src/agent.js loop",
    "status": "node --env-file=.env src/agent.js status",
    "once:live": "node --env-file=.env src/agent.js once --live",
    "loop:live": "node --env-file=.env src/agent.js loop --live",
    "serve": "node --env-file=.env src/server.js",
    "buy": "node --env-file=.env src/buyer.js",
    "serve:live": "node --env-file=.env src/server.js --live"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "viem": "^2.55.10"
  }
}
