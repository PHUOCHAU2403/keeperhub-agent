# Lấy tại app.keeperhub.com -> Settings -> API Keys -> tab Organisation
# KHÔNG dán khoá này vào chat, kể cả cho Claude.
KEEPERHUB_API_KEY=kh_...

# base-sepolia (mặc định, miễn phí) hoặc base
CHAIN=base-sepolia

AGENT_WALLET=0x3dC7e1Cf08299Ba8ad3B0DeA271C0b58F51EC193
# TREASURY=0x...        # để trống thì quét về chính ví agent

# SIMULATE=0            # chỉ đặt khi muốn phát giao dịch THẬT
# SWEEP_FLOOR=5         # giữ lại bao nhiêu USDC làm vốn lưu động
# SWEEP_MIN=1           # dưới mức này thì không quét
# MAX_PER_ACTION=50     # trần một lệnh
# SESSION_BUDGET=200    # trần cả phiên
# INTERVAL_MS=60000
